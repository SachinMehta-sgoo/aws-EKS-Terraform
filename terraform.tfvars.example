# Example values for a minimal private EKS test cluster.
# Copy this file to terraform.tfvars and customize it for your environment.

aws_region = "us-east-1"
project_name = "demo-eks"
environment = "test"

vpc_cidr = "10.20.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]
cluster_version = "1.30"
node_instance_type = "t3.small"
node_desired_capacity = 1
node_min_capacity = 1
node_max_capacity = 2

# Restrict SSH to your own public IP or office/VPN range for safer bastion access.
# Replace this with your actual public IP in CIDR format, for example: "203.0.113.10/32"
# Keep the file local and do not commit it to Git.
bastion_ssh_cidr = "203.0.113.10/32"

# If you want SSH access to the bastion, create a key pair in AWS and set the key name here.
# Example: ssh_key_name = "my-bastion-key"
# If left empty, the bastion will still be created, but SSH access will be disabled.
ssh_key_name = ""
